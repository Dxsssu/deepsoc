# DeepSOC环境变量配置

# 数据库配置
DATABASE_URL="sqlite:////Users/sssu/Project/deepsoc/deepsoc.db"


# 大模型配置
LLM_API_KEY=sk-1d3eea38600b4d9c8eabd930b32f78d8
LLM_MODEL=deepseek-chat
LLM_MODEL_LONG_TEXT=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.6

# 应用配置
FLASK_APP=main.py
FLASK_ENV=development
SECRET_KEY=deepsoc_secret_key_change_in_production

# JWT配置
JWT_SECRET_KEY=deepsoc_jwt_secret_key_change_in_production
JWT_ACCESS_TOKEN_EXPIRES=86400

# SOAR配置
SOAR_API_URL=https://hg-auto.wuzhi-ai.com:18443
SOAR_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.***
SOAR_API_TIMEOUT=30
SOAR_RETRY_COUNT=3
SOAR_RETRY_DELAY=5
SOAR_VERIFY_SSL=False

# 应用配置
LISTEN_HOST=0.0.0.0
LISTEN_PORT=5007

# 调试配置
DEBUG=true

# RabbitMQ Configuration
# 使用127.0.0.1强制IPv4连接，避免IPv6尝试产生的错误日志
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Qdrant Vector Database Configuration
# Docker 启动命令:
# docker run -p 6333:6333 -p 6334:6334 \
#     -v $(pwd)/sql_data/qdrant_storage:/qdrant/storage \
#     qdrant/qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333
QDRANT_STORAGE_PATH=/Users/sssu/Project/deepsoc/sql_data/qdrant_storage

# Knowledge Base Configuration
KB_DEFAULT_TENANT=default
KB_TOP_K=8
KB_SCORE_THRESHOLD=
KB_QDRANT_TIMEOUT=15
KB_EMBEDDING_DIM=256
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_COLLECTION_PREFIX=deepsoc_
# 每类知识一个 Collection（可按需改名）
KB_COLLECTION_KB_PLAYBOOK=deepsoc_kb_playbook
KB_COLLECTION_KB_CONTEXT=deepsoc_kb_context
KB_COLLECTION_KB_CASES=deepsoc_kb_cases
KB_COLLECTION_KB_SECURITY_KNOWLEDGE=deepsoc_kb_security_knowledge
KB_COLLECTION_KB_POLICY_PERSONAL=deepsoc_kb_policy_personal


# Expert Service Worker Intervals (seconds)
EXPERT_EXECUTION_SUMMARY_INTERVAL=10
EXPERT_COMMAND_STATUS_INTERVAL=10
EXPERT_TASK_STATUS_INTERVAL=15
EXPERT_EVENT_ROUND_STATUS_INTERVAL=20
EXPERT_EVENT_SUMMARY_INTERVAL=30
EXPERT_EVENT_NEXT_ROUND_INTERVAL=25
